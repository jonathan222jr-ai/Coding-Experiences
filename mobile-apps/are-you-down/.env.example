# Copy to .env and fill in. Restart the bundler after changing this file:
#   npx expo start -c
#
# Only EXPO_PUBLIC_* variables reach the app, and everything that does is
# embedded in the shipped bundle. The anon key is designed for that — it is
# safe precisely because row-level security decides what it can reach.
# Never put the service_role key in this file.

# Local Supabase (`npx supabase start` prints both of these):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Hosted project instead — Dashboard > Project Settings > API:
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# ---------------------------------------------------------------------------
# Edge Function secrets. Deliberately NOT prefixed EXPO_PUBLIC_ — these never
# reach the app. `supabase start` reads this file and hands them to the
# functions (see [edge_runtime.secrets] in supabase/config.toml); the app
# talks to the functions, never to the vendors.
#
# Restart the stack after changing these — the values are baked in at start:
#   npx supabase stop && npx supabase start
# ---------------------------------------------------------------------------

# GIF search. Free key from https://developers.google.com/tenor/guides/quickstart
# Without it the picker opens and says GIF search isn't set up; messages still
# send. With it, search and the trending grid work.
# TENOR_API_KEY=

# AI report triage (supabase/functions/moderate-report).
# ANTHROPIC_API_KEY=
